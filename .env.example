# --- Discord -------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Where !relay messages from Chatzy are posted
DISCORD_RELAY_CHANNEL_ID=
# Where join notices and connection alerts are posted (may equal the relay channel)
DISCORD_NOTIFICATION_CHANNEL_ID=
# Optional comma-separated allowlists. Empty = rely on Discord's command permissions only.
# Admin commands (/reload /reconnect /browser) also default to "Manage Server" permission.
DISCORD_ADMIN_USER_IDS=
DISCORD_ADMIN_ROLE_IDS=
DISCORD_RELAY_USER_IDS=
DISCORD_RELAY_ROLE_IDS=

# --- Chatzy --------------------------------------------------------------
CHATZY_ROOM_URL=https://us28.chatzy.com/57294990782276
CHATZY_ALIAS=Room Bot
# Optional. Leave empty to type the room password yourself through noVNC.
CHATZY_PASSWORD=
# true = fill the entry form automatically; false = always wait for manual entry
CHATZY_AUTO_JOIN=false
CHATZY_SEND_INTERVAL_MS=1200
CHATZY_MAX_AUTO_RETRIES=5

# --- Manual browser control (container only) ---------------------------
# Required to enable noVNC. VNC passwords are limited to 8 characters.
VNC_PASSWORD=
# Address the noVNC port binds to on the host (e.g. your LAN or Tailscale IP)
NOVNC_BIND=127.0.0.1
# Link shown by /browser and in alerts, e.g. http://192.168.1.10:6080/vnc.html
NOVNC_PUBLIC_URL=

# --- Misc ----------------------------------------------------------------
DATA_DIR=./data
LOG_LEVEL=info
HEALTH_PORT=8080
