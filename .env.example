# --- Discord (webhook, one-way Chatzy -> Discord) -----------------------
# Channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
# Treat it like a password: anyone with it can post to the channel.
DISCORD_WEBHOOK_URL=
# Optional second webhook for join notices and connection alerts.
# Empty = everything goes to DISCORD_WEBHOOK_URL.
DISCORD_NOTIFY_WEBHOOK_URL=
# Display name for notices (relayed messages use "<chatzy name> (Chatzy)")
DISCORD_WEBHOOK_NAME=Chatzy Bot

# --- Chatzy --------------------------------------------------------------
CHATZY_ROOM_URL=https://us28.chatzy.com/57294990782276
CHATZY_ALIAS=Room Bot
# Optional. Leave empty to type the room password yourself through noVNC.
CHATZY_PASSWORD=
# true = fill the entry form automatically; false = always wait for manual entry
CHATZY_AUTO_JOIN=false
CHATZY_SEND_INTERVAL_MS=1200
CHATZY_MAX_AUTO_RETRIES=5
# Continuous outage window before the exhausted-retry alert (2 minutes).
CHATZY_RECOVERY_TIMEOUT_MS=120000
# Silent keep-alive so Chatzy's 60-minute "You seem to be away" prompt never
# appears: opens and closes "My Messages" at a random interval in this range.
CHATZY_KEEPALIVE=true
CHATZY_KEEPALIVE_MIN_MS=600000
CHATZY_KEEPALIVE_MAX_MS=1500000

# Optional first-run command and notification settings (editable in the UI).
COMMAND_PREFIX=!
COMMAND_HELP=true
COMMAND_RELAY=true
RELAY_COOLDOWN_MS=10000
NOTIFY_JOINS=true
NOTIFY_CONNECTION=true
# Initial defaults for the joke selector only. After commands.json exists,
# use Custom commands in the UI to enable/disable it and change its cooldown.
COMMAND_JOKE=true
JOKE_COOLDOWN_MS=5000

# --- Manual browser control (container only) ---------------------------
# Required to enable noVNC. VNC passwords are limited to 8 characters.
VNC_PASSWORD=
# Address the noVNC port binds to on the host (e.g. your LAN or Tailscale IP)
NOVNC_BIND=127.0.0.1
# Link included in "needs manual attention" alerts, e.g. http://192.168.1.10:6080/vnc.html
NOVNC_PUBLIC_URL=

# --- Misc ----------------------------------------------------------------
# Settings and custom commands are seeded once, then saved here.
CONFIG_DIR=./config
# Host directory mounted as /config (Compose/Portainer).
CONFIG_PATH=./config
# Absolute host path for the Portainer /data bind mount.
DATA_PATH=/opt/chatzy-bot/data
WEBUI_BIND=127.0.0.1
# Optional Basic authentication for the Web UI (username: admin).
WEBUI_PASSWORD=
# Internal Web UI listener port; Compose publishes container port 3000.
WEBUI_PORT=3000
DATA_DIR=./data
LOG_LEVEL=info
HEALTH_PORT=8080
