{
  "name": "chatzy-bot",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "chatzy:console": "bun src/scripts/console.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "solid-js": "^1.9.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-solid": "^2.11.14"
  }
}
